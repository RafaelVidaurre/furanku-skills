          "implementation": { "minimum": 0.55, "weight": 2.0 },
          "reasoning": { "minimum": 0.5, "weight": 2.0 },
          "agentic": { "minimum": 0.55, "weight": 1.0 }
        },
        "priority": ["cost", "latency", "quota"]
      },
      "ui-product": {
        "description": "Design or implement a user-facing surface; UI preference is evidence, product empathy remains unmeasured.",
