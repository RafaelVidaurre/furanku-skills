      "unknown_quota": "allow-with-warning",
      "evidence_methodology": {
        "reasoning": "Artificial Analysis Intelligence Index divided by 100 when exact; otherwise a labeled effort proxy.",
        "implementation": "DeepSWE resolved-task rate when exact; otherwise a labeled effort proxy.",
        "agentic": "Ordinal normalization of dated Agent Arena or agentic-work evidence.",
        "ui": "Ordinal normalization of the dated Arena WebDev preference ranking.",
        "spatial-3d": "Ordinal normalization of the dated Design Arena browser-3D ranking.",
        "conservative": "A documented lower estimate reflecting effort or harness transfer and evidence confidence; it is the value used for routing."
      },
      "evidence_boundary": "Public research only. No local model evaluation contributes capability scores; missing direct evidence remains unknown or is named as a proxy in the specialization."
    },
