        "description": "Diagnose and repair a repository defect.",
        "needs": {
          "implementation": { "minimum": 0.6, "weight": 3.0 },
          "reasoning": { "minimum": 0.52, "weight": 2.0 },
          "agentic": { "minimum": 0.55, "weight": 1.0 }
        },
        "priority": ["cost", "latency", "quota"]
      },
      "review": {
        "description": "Review a change using implementation, reasoning, and agentic evidence as explicit proxies because direct comparative review evidence is unavailable.",
