          "ui": { "minimum": 0.8, "weight": 3.0, "critical": true },
          "implementation": { "minimum": 0.6, "weight": 1.0 },
          "agentic": { "minimum": 0.65, "weight": 1.0 }
        },
        "priority": ["quota", "cost", "latency"]
      },
      "spatial-3d": {
        "description": "Build a visual or browser-based spatial 3D outcome; this does not claim general production modeling competence.",
        "needs": {
          "spatial-3d": { "minimum": 0.8, "weight": 3.0, "critical": true },
          "implementation": { "minimum": 0.6, "weight": 1.0 }
        },
        "priority": ["quota", "cost", "latency"]
      },
