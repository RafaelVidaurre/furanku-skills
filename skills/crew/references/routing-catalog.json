      "architecture": {
        "description": "Design module seams, contracts, and implementation plans.",
        "needs": {
          "reasoning": { "minimum": 0.54, "weight": 2.0 },
          "agentic": { "minimum": 0.8, "weight": 3.0, "critical": true }
        },
        "priority": ["quota", "cost", "latency"]
      },
      "planning": {
        "description": "Decompose and sequence a complex implementation front.",
        "needs": {
          "reasoning": { "minimum": 0.54, "weight": 2.0 },
          "agentic": { "minimum": 0.8, "weight": 3.0, "critical": true }
        },
        "priority": ["quota", "cost", "latency"]
      },
      "implementation": {
        "description": "Implement a bounded repository outcome.",
        "needs": {
          "implementation": { "minimum": 0.65, "weight": 3.0 },
          "agentic": { "minimum": 0.55, "weight": 1.0 }
        },
        "priority": ["cost", "latency", "quota"]
      },
