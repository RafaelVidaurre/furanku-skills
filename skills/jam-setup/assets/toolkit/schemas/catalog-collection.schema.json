{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-collection.schema.json",
  "$ref": "#/$defs/CollectionRecord",
  "$defs": {
    "CollectionRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_-]{0,119}$"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[^/\\s][^/]{0,63}(\\/[^/\\s][^/]{0,63}){0,7}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:._/+-]{0,63}$"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "createdBy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "human",
                    "agent"
                  ]
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestBinding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "checkout": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "digest",
                "checkout"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "tags",
        "members",
        "revision"
      ],
      "additionalProperties": true
    }
  }
}
