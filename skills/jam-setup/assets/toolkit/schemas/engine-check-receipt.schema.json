{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-check-receipt.schema.json",
  "$ref": "#/$defs/EngineCheckReceipt",
  "$defs": {
    "EngineCheckReceipt": {
      "type": "object",
      "properties": {
        "problems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "pattern": "\\S"
              },
              "fix": {
                "type": "string"
              }
            },
            "required": [
              "message"
            ],
            "additionalProperties": false
          }
        },
        "report": {}
      },
      "required": [
        "problems"
      ],
      "additionalProperties": false,
      "title": "Receipt printed by an adapter's check command"
    }
  }
}
