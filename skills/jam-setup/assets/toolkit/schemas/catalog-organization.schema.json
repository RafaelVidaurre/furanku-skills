{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-organization.schema.json",
  "$ref": "#/$defs/OrganizationRecord",
  "$defs": {
    "OrganizationRecord": {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "unit",
                "asset",
                "collection"
              ]
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": true
        },
        "category": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[^/\\s][^/]{0,63}(\\/[^/\\s][^/]{0,63}){0,7}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:._/+-]{0,63}$"
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "target",
        "tags",
        "revision"
      ],
      "additionalProperties": true,
      "description": "Category and tags of one unit, asset or project-owned collection"
    }
  }
}
