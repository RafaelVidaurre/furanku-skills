{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-submission.schema.json",
  "$ref": "#/$defs/SubmissionRecord",
  "$defs": {
    "SubmissionRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sub_[a-z0-9]+$"
        },
        "title": {
          "type": "string"
        },
        "by": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "agent"
              ]
            }
          },
          "required": [
            "name",
            "kind"
          ],
          "additionalProperties": true
        },
        "at": {
          "type": "string"
        },
        "checkout": {
          "type": "object",
          "properties": {
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "head": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dirty": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sub_[a-z0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ask": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "brief": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "changes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^it_[a-z0-9]+$"
                },
                "target": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "unit",
                            "collection"
                          ]
                        },
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "additionalProperties": true
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "title": {
                  "type": "string"
                },
                "text": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "unit",
                    "collection",
                    "work"
                  ]
                },
                "definition": {},
                "parts": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "evidence": {}
                      },
                      "required": [
                        "id",
                        "label",
                        "evidence"
                      ],
                      "additionalProperties": true
                    }
                  ],
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "evidence": {}
                    },
                    "required": [
                      "id",
                      "label",
                      "evidence"
                    ],
                    "additionalProperties": true
                  }
                },
                "views": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "preview": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "module": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "module"
                      ],
                      "additionalProperties": true
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "target",
                "title",
                "definition",
                "parts",
                "views"
              ],
              "additionalProperties": true
            }
          ],
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^it_[a-z0-9]+$"
              },
              "target": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "unit",
                          "collection"
                        ]
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "id"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string"
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "unit",
                  "collection",
                  "work"
                ]
              },
              "definition": {},
              "parts": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "evidence": {}
                    },
                    "required": [
                      "id",
                      "label",
                      "evidence"
                    ],
                    "additionalProperties": true
                  }
                ],
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "evidence": {}
                  },
                  "required": [
                    "id",
                    "label",
                    "evidence"
                  ],
                  "additionalProperties": true
                }
              },
              "views": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "preview": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "module": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "module"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "target",
              "title",
              "definition",
              "parts",
              "views"
            ],
            "additionalProperties": true
          }
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestBinding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "checkout": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "digest",
                "checkout"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "by",
        "at",
        "checkout",
        "items"
      ],
      "additionalProperties": true
    }
  }
}
