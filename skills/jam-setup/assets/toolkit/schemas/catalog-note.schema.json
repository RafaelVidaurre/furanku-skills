{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-note.schema.json",
  "$ref": "#/$defs/NoteRecord",
  "$defs": {
    "NoteRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^nt_[a-z0-9]+$"
        },
        "target": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "unit",
                "collection",
                "asset",
                "submission"
              ]
            },
            "id": {
              "type": "string"
            },
            "item": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "part": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "view": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": true
        },
        "body": {
          "type": "string"
        },
        "by": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "human",
                "agent"
              ]
            }
          },
          "required": [
            "name",
            "kind"
          ],
          "additionalProperties": true
        },
        "at": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "editedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "by": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "human",
                        "agent"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "kind"
                  ],
                  "additionalProperties": true
                },
                "at": {
                  "type": "string"
                },
                "explanation": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "by",
                "at"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestBinding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "checkout": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "digest",
                "checkout"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "lastRequestId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastRequestBinding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "checkout": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "digest",
                "checkout"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "target",
        "body",
        "by",
        "at",
        "revision"
      ],
      "additionalProperties": true
    }
  }
}
