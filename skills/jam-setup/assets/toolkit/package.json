{
  "name": "jam-toolkit",
  "version": "3.2.2",
  "private": true,
  "type": "module",
  "description": "Jam toolkit: recipes, runs, spending ledger, providers, engine adapters and the content catalog.",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "jam": "jam.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:unit": "node --test \"test/kernel/*.test.ts\" \"test/jam/*.test.ts\"",
    "schemas": "node src/cli/main.ts schemas write"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "dompurify": "3.4.17",
    "effect": "4.1.4",
    "htm": "3.1.1",
    "marked": "18.2.0",
    "playwright": "1.65.0",
    "preact": "11.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
