{
  "version": 1,
  "adapter": "manifest",
  "options": {
    "manifest": "content/catalog.manifest.json"
  },
  "previewModules": {
    "lineup": "./previews/lineup.mjs"
  },
  "review": {
    "resolver": "strictest",
    "referenceRoles": [
      "concept"
    ],
    "verdicts": [
      "approved",
      "changes",
      "rejected"
    ]
  },
  "display": {
    "pixelArt": true
  }
}
